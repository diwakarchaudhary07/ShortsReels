# Apple Music API developer token credentials.
# Create a MusicKit identifier and media services private key in Apple Developer.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APPLE_MUSIC_STOREFRONT=in

# Catalog refresh and preview URLs do not grant synchronization rights to use
# a recording in user-created video. Obtain separate rights for that use.
